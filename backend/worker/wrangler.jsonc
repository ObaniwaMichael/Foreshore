{
  "$schema": "https://unpkg.com/wrangler@4.158.0/config-schema.json",
  "name": "foreshore-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["python_workers"],
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foreshore-db",
      "database_id": "bba1b762-2f18-4762-9be0-51b19d668268",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "foreshore-uploads" },
    { "binding": "BACKUPS", "bucket_name": "foreshore-backups" }
  ]
}